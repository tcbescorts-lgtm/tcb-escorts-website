{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/portal",
      "destination": "https://tcb-escorts-portal-tcb-escorts.vercel.app/portal"
    },
    {
      "source": "/portal/:path*",
      "destination": "https://tcb-escorts-portal-tcb-escorts.vercel.app/portal/:path*"
    },
    {
      "source": "/driver",
      "destination": "https://tcb-escorts-portal-tcb-escorts.vercel.app/driver"
    },
    {
      "source": "/driver/:path*",
      "destination": "https://tcb-escorts-portal-tcb-escorts.vercel.app/driver/:path*"
    },
    {
      "source": "/sign-in",
      "destination": "https://tcb-escorts-portal-tcb-escorts.vercel.app/sign-in"
    },
    {
      "source": "/auth/:path*",
      "destination": "https://tcb-escorts-portal-tcb-escorts.vercel.app/auth/:path*"
    },
    {
      "source": "/_next/:path*",
      "destination": "https://tcb-escorts-portal-tcb-escorts.vercel.app/_next/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://tcb-escorts-portal-tcb-escorts.vercel.app/api/:path*"
    },
    {
      "source": "/t/:path*",
      "destination": "https://tcb-escorts-portal-tcb-escorts.vercel.app/t/:path*"
    },
    {
      "source": "/i/:path*",
      "destination": "https://tcb-escorts-portal-tcb-escorts.vercel.app/i/:path*"
    },
    {
      "source": "/app",
      "destination": "https://tcb-escorts-portal-tcb-escorts.vercel.app/app"
    },
    {
      "source": "/forbidden",
      "destination": "https://tcb-escorts-portal-tcb-escorts.vercel.app/forbidden"
    },
    {
      "source": "/manifest.webmanifest",
      "destination": "https://tcb-escorts-portal-tcb-escorts.vercel.app/manifest.webmanifest"
    },
    {
      "source": "/sw.js",
      "destination": "https://tcb-escorts-portal-tcb-escorts.vercel.app/sw.js"
    },
    {
      "source": "/favicon.ico",
      "destination": "https://tcb-escorts-portal-tcb-escorts.vercel.app/favicon.ico"
    },
    {
      "source": "/apple-touch-icon.png",
      "destination": "https://tcb-escorts-portal-tcb-escorts.vercel.app/apple-touch-icon.png"
    },
    {
      "source": "/icon-maskable-192.png",
      "destination": "https://tcb-escorts-portal-tcb-escorts.vercel.app/icon-maskable-192.png"
    },
    {
      "source": "/icon-maskable-512.png",
      "destination": "https://tcb-escorts-portal-tcb-escorts.vercel.app/icon-maskable-512.png"
    },
    {
      "source": "/logo-112.png",
      "destination": "https://tcb-escorts-portal-tcb-escorts.vercel.app/logo-112.png"
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(png|jpg|jpeg|svg|webp)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/(.*)\\.(css|js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
